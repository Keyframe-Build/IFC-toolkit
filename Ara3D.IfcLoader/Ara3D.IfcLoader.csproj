<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ara3D.IfcParser\Ara3D.IfcParser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Ara3D.Utils">
      <HintPath>..\..\Utils\Ara3D.Utils\bin\Debug\netstandard2.0\Ara3D.Utils.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="libs/web-ifc.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>web-ifc.dll</Link>
    </None>
    <None Include="libs/libweb-ifc.so"> 
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libweb-ifc.so</TargetPath>
    </None>
  </ItemGroup>
</Project>
